# ==========================================
# CONFIGURACIÓN DE PRODUCCIÓN - SINCROIA.LAT
# ==========================================

# 1. NOTIFICACIÓN INMEDIATA POR TELEGRAM (Opcional - Alerta push a tu celular en < 1s)
# Crea un bot en 1 min con @BotFather y obtén tu chat ID con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. WEBHOOK UNIVERSAL (Opcional - Google Sheets CRM / Discord / Slack / Zapier)
LEADS_WEBHOOK_URL=

# 3. NÚMERO OFICIAL DE WHATSAPP (Con código de país, ej. 573001234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=573124630488

# 4. ANALÍTICA DE CONVERSIÓN (Google Analytics 4, ej. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# 5. GOOGLE SEARCH CONSOLE (Código de verificación de etiqueta HTML)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 6. AGENTE DE IA EN WHATSAPP (Google Gemini API gratuita de aistudio.google.com)
GEMINI_API_KEY=

# 7. CONEXIÓN GATEWAY DE WHATSAPP (Evolution API / Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=sincroia_secure_token
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=sincroia